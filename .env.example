# ============================================================
#  Anchor — environment contract
#  Copy to .env.local and fill in. .env.local is gitignored.
# ============================================================

# ---- Supabase -----------------------------------------------
# Dashboard → Settings → API Keys. (There is no longer a separate
# Settings → API page; every key, legacy or not, lives under API Keys.)
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key, sb_publishable_...
# Safe in the browser: every table has RLS enabled, so it grants nothing
# on its own. This replaces the legacy `anon` JWT, which Supabase is
# deprecating at the end of 2026 — use the new format on a new project.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret key, sb_secret_...  (replaces the legacy `service_role` JWT)
# Bypasses RLS entirely. Server-only, never on a request path — it is
# needed just for seeding the demo account. Supabase rejects it with a 401
# if it is ever sent from a browser, but do not rely on that as the guard.
SUPABASE_SECRET_KEY=

# ---- Gemini -------------------------------------------------
# aistudio.google.com → Get API key. Free tier, no card.
# Server-only: it must never be prefixed NEXT_PUBLIC_.
GEMINI_API_KEY=

# Turn-by-turn negotiation: high volume, latency matters most.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Feedback report: one call per session, quality matters most.
GEMINI_REPORT_MODEL=gemini-3.8-flash

# ---- App ----------------------------------------------------
# Used for OAuth redirects and OG metadata. Set to the real origin in
# production, e.g. https://anchor.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the keepalive cron that stops the Supabase free-tier
# project pausing after 7 days of inactivity. Any long random string.
CRON_SECRET=

# ---- Demo account -------------------------------------------
# Optional. When set, the sign-in page offers a one-click demo login,
# and scripts/seed-demo.mts populates that account with history.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
