# ============================================================
#  Anchor — environment contract
#  Copy to .env.local and fill in. .env.local is gitignored.
# ============================================================

# ---- Supabase -----------------------------------------------
# Dashboard → Project Settings → Data API / API Keys.
# The anon key is safe in the browser: every table has RLS enabled,
# so it grants nothing on its own.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — never expose it to the client and
# never use it on a request path. Needed only for seeding the demo account.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Gemini -------------------------------------------------
# aistudio.google.com → Get API key. Free tier, no card.
# Server-only: it must never be prefixed NEXT_PUBLIC_.
GEMINI_API_KEY=

# Turn-by-turn negotiation: high volume, latency matters most.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Feedback report: one call per session, quality matters most.
GEMINI_REPORT_MODEL=gemini-3.8-flash

# ---- App ----------------------------------------------------
# Used for OAuth redirects and OG metadata. Set to the real origin in
# production, e.g. https://anchor.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the keepalive cron that stops the Supabase free-tier
# project pausing after 7 days of inactivity. Any long random string.
CRON_SECRET=
